# ChamPDF frontend build variables (Vite inlines VITE_* at build time).
# Copy to .env.local for local dev; on Railway set them as build args of the
# champdf-frontend service; on Vercel as project environment variables.

# Backend origin. Leave empty when the frontend is served behind the nginx
# /api proxy (Railway) or a Vercel rewrite; set it for `npm run dev`.
VITE_API_URL=

# Clerk publishable key (pk_...). Enables sign-in, the self-serve API key
# panel, and the ChampPDF Sign sender console. Without it the console offers
# developer mode with the backend admin token.
VITE_CLERK_PUBLISHABLE_KEY=
