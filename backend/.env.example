# =========================================
# chamPDF Backend Environment Configuration
# =========================================

# App Configuration
PORT=8000
HOST=0.0.0.0

# =========================================
# CORS Configuration (CRITICAL FOR PRODUCTION)
# =========================================
# Comma-separated list of allowed origins
# Development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Production example:
# ALLOWED_ORIGINS=https://champdf.com,https://www.champdf.com,https://champdf.pages.dev

# =========================================
# Logging Configuration
# =========================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Development: INFO
# Production: WARNING or ERROR (reduces log verbosity)
LOG_LEVEL=INFO

# =========================================
# File Upload Limits
# =========================================
# Maximum file sizes in megabytes
MAX_VIDEO_SIZE_MB=100
MAX_IMAGE_SIZE_MB=10
MAX_FILE_SIZE=104857600  # 100MB in bytes (calculated automatically from MAX_VIDEO_SIZE_MB)

# =========================================
# Resource Limits
# =========================================
# Maximum number of concurrent heavy processing jobs (prevents OOM)
# Recommended: 2 for Railway/Render, adjust based on available memory
MAX_CONCURRENT_JOBS=2

# Timeout for ML/FFmpeg tasks in seconds
PROCESS_TIMEOUT=300  # 5 minutes

# Health check timeout in seconds
HEALTH_CHECK_TIMEOUT=10

# =========================================
# AI Features (watermark removal, captions, upscaling)
# =========================================
# Device for ML models: auto | cpu | cuda
DEVICE=auto

# LaMa inpainting (Image/PDF watermark removal). Set false to disable.
ENABLE_INPAINT=true

# Video captions (faster-whisper). Model: tiny|base|small|medium|large-v3
ENABLE_CAPTIONS=true
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8

# Image upscaling (Real-ESRGAN). Max scale: 2 or 4
ENABLE_UPSCALE=true
UPSCALE_MAX_SCALE=4
UPSCALE_MAX_PIXELS=4000000

# Watermark auto-detection (OpenCV template matching).
# Drop reference PNGs in backend/assets/watermark_templates/ to enable.
WATERMARK_MATCH_THRESHOLD=0.62
WATERMARK_SAMPLE_FRAMES=12

# Video transcript → AI summary (Video Downloader). Transcript uses Whisper
# (no key). The AI summary uses OpenRouter — set a key to enable it.
# OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_REFERER=https://champdf.com

# Multimodal YouTube analysis (Video Downloader "Analyze video"). Passes the
# YouTube URL straight to Gemini (visual + audio). Uses GEMINI_API_KEY.
GEMINI_VIDEO_MODEL=gemini-2.5-flash

# GPU video watermark removal (Video Rebrander "Best" quality). Railway has no
# GPU, so the heavy inpainting is offloaded to a hosted provider. Leave the
# provider as "none" to keep everything on the local CPU path.
#   VIDEO_GPU_PROVIDER=replicate
#   REPLICATE_API_TOKEN=r8_...
VIDEO_GPU_PROVIDER=none
# Replicate model slug for video inpainting (owner/name or owner/name:version).
REPLICATE_PROPAINTER_MODEL=jd7h/propainter
# Same Replicate token also powers these GPU add-ons (override slugs if needed):
#   Video Background Remover (Robust Video Matting):
REPLICATE_RVM_MODEL=arielreplicate/robust_video_matting
#   Better Captions (GPU Whisper large-v3):
REPLICATE_WHISPER_MODEL=vaibhavs10/incredibly-fast-whisper
# Max seconds to wait for the external GPU job, and max clip length to offload.
# Keep GPU_VIDEO_TIMEOUT under the frontend Nginx proxy_read_timeout (900s).
GPU_VIDEO_TIMEOUT=840
GPU_VIDEO_MAX_SECONDS=120

# Compliance PDF signing (pyHanko) + server OCR (OCRmyPDF). Both activate
# automatically when their deps are installed (they are in Dockerfile.railway).
ENABLE_PDF_SIGN=true
# Trusted timestamp authority for PAdES B-T. Empty disables timestamping.
PDF_TSA_URL=http://timestamp.digicert.com

# =========================================
# Public API — self-serve keys for signed-in (Clerk) users
# =========================================
# Lets a user who signed in with Clerk mint their own ChamPDF API key from the
# account menu, then hand it (plus the MCP config) to their AI assistant. The
# admin key path (CHAMPDF_ADMIN_TOKEN) keeps working regardless.
#
# Dormant until CLERK_ISSUER is set. CLERK_ISSUER is your Clerk Frontend API URL
# (Clerk dashboard → API keys → "Frontend API URL"), e.g.
#   https://clerk.champdf.com           (production)
#   https://your-app-12.clerk.accounts.dev  (development)
# CLERK_ISSUER=
# Optional explicit JWKS URL; defaults to <CLERK_ISSUER>/.well-known/jwks.json
# CLERK_JWKS_URL=
# Optional — only needed to restrict key issuance by email domain when the
# Clerk session token has no email claim (used to look the email up).
# CLERK_SECRET_KEY=sk_live_...
# Optional allowlist: comma-separated email domains permitted to mint keys.
# Empty => any signed-in user may mint one. Example to lock to the team:
# CHAMPDF_API_KEY_EMAIL_DOMAINS=championsmail.com

# Admin token for issuing/revoking keys directly (server-to-server). Unset =>
# the /api/v1/admin/keys endpoints return 503.
# CHAMPDF_ADMIN_TOKEN=

# =========================================
# Paths (Optional - Auto-detected)
# =========================================
# Base temporary directory (defaults to system temp if not set)
# BASE_TEMP_DIR=/tmp/champdf-backend

# Logo directory (defaults to ./assets/logos if not set)
# LOGO_DIR=/app/assets/logos

# Model cache directory (defaults to ~/.u2net)
# Useful for Docker deployments with persistent volumes
# MODEL_CACHE_DIR=/app/models

# =========================================
# Railway-Specific Variables
# =========================================
# These are set automatically by Railway - DO NOT SET MANUALLY

# PORT - Railway assigns dynamically (overrides PORT above)
# WEB_CONCURRENCY - Number of uvicorn workers (default: 2)

# =========================================
# Usage Examples
# =========================================
# Local Development:
#   Copy this file to .env and use defaults
#
# Railway Production:
#   Set in Railway Dashboard > Variables:
#   - ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
#   - LOG_LEVEL=WARNING
#   - MAX_CONCURRENT_JOBS=2
#
# Docker Production:
#   Pass via docker run -e or docker-compose environment section

# =========================================
# ChampPDF Sign — templates in, sealed signature out (docs/sign/README.md)
# =========================================
# Works with nothing set: log-only mail, local write-once storage, a
# self-signed seal, admin-token senders. Set these before any external send.
ENABLE_SIGN=true
# Engine behind the SigningProvider seam: native (default) | documenso
SIGN_PROVIDER=native
# Public origin used in signing links and the console (defaults to the request origin).
# SIGN_PUBLIC_BASE_URL=https://champdf.com
# Contracting entity block rendered into every template. Never a trading name.
SIGN_ENTITY_NAME=Champions Superior Capital
# SIGN_ENTITY_CIN=
# SIGN_ENTITY_ADDRESS=
# SIGN_ENTITY_SIGNATORY=
# SIGN_ENTITY_SIGNATORY_DESIGNATION=Director
# Who may send. Comma-separated email domains for Clerk users. Defaults to
# championsmail.com because champdf.com sign-up is public.
# SIGN_SENDER_EMAIL_DOMAINS=championsmail.com
# Identity used when sending with X-Admin-Token (local dry runs).
# SIGN_ADMIN_EMAIL=deep@championsmail.com
# SIGN_ADMIN_NAME=ChampPDF Admin

# Seal certificate (organisation PKCS#12). Unset => a self-signed seal is
# generated once under the data dir and reported as self_signed.
# SIGN_SEAL_P12_B64=            # base64 of the .p12, or:
# SIGN_SEAL_P12_PATH=/app/data/sign/seal.p12
# SIGN_SEAL_P12_PASSWORD=
# RFC 3161 timestamp on the seal (uses PDF_TSA_URL). false => no timestamp.
SIGN_SEAL_TIMESTAMP=true

# Transactional email. Dedicated subdomain, never cold-outbound infrastructure.
# RESEND_API_KEY=re_...
# SIGN_EMAIL_FROM=Champions Superior Capital <notifications@sign.championsmail.com>
# RESEND_WEBHOOK_SECRET=whsec_...   # enables POST /api/sign/webhooks/resend

# ChampBeam tracked links (instrumentation only; security is the token + OTP).
# CHAMPBEAM_API_URL=https://beam.example/api/links
# CHAMPBEAM_API_TOKEN=

# Sealed-PDF storage. Unset => local disk under the data volume.
# SIGN_STORAGE_BUCKET=champdf-sign
# SIGN_STORAGE_PREFIX=
# SIGN_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # R2; omit for AWS S3
# SIGN_STORAGE_REGION=auto
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=

# Documenso (only with SIGN_PROVIDER=documenso). Unmodified image, private
# network, service token. See docker-compose.sign.yml.
# DOCUMENSO_BASE_URL=http://documenso:3000
# DOCUMENSO_API_TOKEN=

# =========================================
# Media providers — per-capability engine switch (docs/media-providers.md)
# =========================================
# Each capability: auto | local | replicate | openrouter | gemini | opencv | off
# (not every value applies to every capability; see the doc). "auto" takes the
# first configured engine and keeps the local model as the fallback.
MEDIA_EDIT_PROVIDER=auto
MEDIA_INPAINT_PROVIDER=auto
MEDIA_BG_PROVIDER=auto
MEDIA_UPSCALE_PROVIDER=auto
# Replicate model slugs (owner/name, or owner/name:version to pin).
# MEDIA_REPLICATE_EDIT_MODEL=google/nano-banana
# MEDIA_REPLICATE_INPAINT_MODEL=allenhooo/lama
# MEDIA_REPLICATE_BG_MODEL=cjwbw/rembg
# MEDIA_REPLICATE_UPSCALE_MODEL=nightmareai/real-esrgan
# OpenRouter prompt editing (Edit Banana without a Gemini key).
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# OPENROUTER_VIA_TREG=false
# Spend ceiling per treg-metered call and per-job timeout for hosted engines.
MEDIA_MAX_COST_USD=0.25
MEDIA_HOSTED_TIMEOUT_S=300

# treg (https://treg.to): credential gateway + catalogue. With TREG_TOKEN set,
# Replicate calls (media providers AND the video GPU offload) go through treg
# using the org's Replicate key held there; REPLICATE_VIA_TREG=false forces
# the direct REPLICATE_API_TOKEN path.
# TREG_TOKEN=            # per-org token from `treg org agent-new champdf-backend`
# TREG_ORG=champions-accelerator   # only needed with an identity token
# TREG_META_APP=champdf
# REPLICATE_VIA_TREG=true
