{
  "name": "@champ-deep/champdf-mcp",
  "version": "0.1.0",
  "description": "MCP server for ChamPDF — let Claude Code and other AI agents call ChamPDF's tools (PDF watermark removal, image editing, video processing) natively.",
  "license": "MIT",
  "homepage": "https://champdf.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Champ-Deep/ChamPDF.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/Champ-Deep/ChamPDF/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "champdf",
    "pdf",
    "claude",
    "ai-agent",
    "image-editing",
    "watermark-remover",
    "gemini"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "champdf-mcp": "./dist/index.js",
    "champdf-mcp-http": "./dist/http.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
