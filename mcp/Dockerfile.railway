# ChamPDF MCP Server (HTTP/SSE variant) — Railway deployment.
#
# Hosts the same MCP tools the npm-published stdio variant exposes, but
# over HTTP so users without Node locally can connect from Claude Desktop
# / web-based MCP clients via a URL.
#
# Build context: must be the repo root (so we can COPY mcp/...). Railway
# settings: dockerfilePath = "mcp/Dockerfile.railway", root = ".".

FROM node:20-alpine AS builder
WORKDIR /app
COPY mcp/package*.json ./
RUN npm ci --no-audit --no-fund
COPY mcp/tsconfig.json ./
COPY mcp/src ./src
RUN npm run build && \
    npm prune --omit=dev

FROM node:20-alpine
WORKDIR /app

# Non-root user for runtime (Alpine includes a 'node' user out of the box)
USER node

COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/dist ./dist
COPY --from=builder --chown=node:node /app/package.json ./package.json

ENV NODE_ENV=production
ENV PORT=8081
EXPOSE 8081

# Health check hits /healthz, which is plain-text and unauthenticated
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://localhost:'+(process.env.PORT||8081)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/http.js"]
