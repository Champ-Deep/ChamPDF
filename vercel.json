{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.champdf.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://api.champdf.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://api.champdf.com/openapi.json"
    }
  ]
}
